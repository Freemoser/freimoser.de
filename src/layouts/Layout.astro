---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'Freimoser — AI Engineering & Automation', description = 'S. Thomas Freimoser — KI-gestützte Automatisierung, Data Engineering und intelligente Agenten-Systeme.' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>

  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">Frei<span>moser</span></a>
      <button class="nav-toggle" id="navToggle" aria-label="Navigation umschalten">☰</button>
      <ul class="nav-links" id="navLinks">
        <li><a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a></li>
        <li><a href="/projekte/" aria-current={currentPath.startsWith('/projekte') ? 'page' : undefined}>Projekte</a></li>
        <li><a href="/ueber-mich/" aria-current={currentPath.startsWith('/ueber-mich') ? 'page' : undefined}>Über mich</a></li>
        <li><a href="/kontakt/" aria-current={currentPath.startsWith('/kontakt') ? 'page' : undefined}>Kontakt</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <span class="footer-copy">&copy; {new Date().getFullYear()} Freimoser</span>
      <ul class="footer-links">
        <li><a href="https://github.com/Freemoser" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href="https://linkedin.com/in/freimoser" target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href="/impressum/">Impressum</a></li>
        <li><a href="/datenschutz/">Datenschutz</a></li>
      </ul>
    </div>
  </footer>

  <script>
    document.getElementById('navToggle')?.addEventListener('click', () => {
      document.getElementById('navLinks')?.classList.toggle('open');
    });
  </script>
</body>
</html>
